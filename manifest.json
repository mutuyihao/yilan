{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.5.1",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "64": "icon/icon64.png",
    "128": "icon/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/action16.png",
      "32": "icon/action32.png",
      "48": "icon/action48.png",
      "64": "icon/action64.png",
      "128": "icon/action128.png"
    }
  },
  "commands": {
    "trigger-summary": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_shortcutDescription__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
